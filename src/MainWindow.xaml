<Window x:Class="GeminiLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GeminiLauncher"
        Title="Gemini Launcher" Width="800" Height="620" MinWidth="800" MaxWidth="800" MinHeight="620" MaxHeight="620"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" ShowActivated="True"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Fg1}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <!-- Result row -->
        <DataTemplate x:Key="ResultTemplate" DataType="{x:Type local:ResultItem}">
            <Grid Height="44" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="26" Height="26" HorizontalAlignment="Left" Margin="4,0,0,0">
                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Path Data="{Binding Glyph}" Stroke="{DynamicResource Fg2}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stretch="Uniform" Width="17" Height="17" x:Name="GlyphPath"/>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13.5" Foreground="{DynamicResource Fg1}"/>
                    <TextBlock Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" FontSize="11.5" Foreground="{DynamicResource Fg3}" x:Name="Sub"/>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Subtitle}" Value="{x:Null}">
                    <Setter TargetName="Sub" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Gemini">
                    <Setter TargetName="GlyphPath" Property="Fill" Value="{DynamicResource GeminiBrush}"/>
                    <Setter TargetName="GlyphPath" Property="Stroke" Value="{x:Null}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="HeaderTemplate" DataType="{x:Type local:ResultItem}">
            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Fg2}" Margin="6,12,0,4"/>
        </DataTemplate>

        <local:ResultTemplateSelector x:Key="Selector" Item="{StaticResource ResultTemplate}" Header="{StaticResource HeaderTemplate}"/>

        <Style x:Key="ResultContainer" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="0,1" Padding="6,0">
                            <Grid>
                                <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource AccentText}"
                                        HorizontalAlignment="Left" Margin="-6,0,0,0" Visibility="Collapsed"/>
                                <ContentPresenter/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelBg}"/>
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                <Setter Property="IsHitTestVisible" Value="False"/>
                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                <Setter TargetName="Pill" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Home: pinned tile -->
        <Style x:Key="TileButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="Width" Value="122"/>
            <Setter Property="Height" Value="86"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0,0,2,2"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
            <Style.Triggers>
                <!-- Tile being dragged to a new position: lifted and translucent -->
                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                    <Setter Property="Opacity" Value="0.7"/>
                    <Setter Property="Background" Value="{DynamicResource SelBg}"/>
                    <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.06" ScaleY="1.06"/></Setter.Value></Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Small X button on removable home rows -->
        <Style x:Key="RemoveButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Visibility" Value="Hidden"/>
        </Style>
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type local:ResultItem}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="32" Height="32" Margin="0,2,0,7">
                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Path Data="{Binding Glyph}" Stroke="{DynamicResource Fg2}" StrokeThickness="1.4" Stretch="Uniform" Width="20" Height="20"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Grid>
                <TextBlock Text="{Binding Title}" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"
                           Foreground="{DynamicResource Fg1}" MaxWidth="110"/>
            </StackPanel>
        </DataTemplate>

        <!-- Home: list row (recommended / searches) -->
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="46"/>
        </Style>
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type local:ResultItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Width="26" Height="26" HorizontalAlignment="Left">
                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Path Data="{Binding Glyph}" Stroke="{DynamicResource Fg2}" StrokeThickness="1.4" Stretch="Uniform" Width="16" Height="16"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Fg1}"/>
                    <TextBlock Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" FontSize="11.5" Foreground="{DynamicResource Fg3}"/>
                </StackPanel>
                <Button x:Name="RemoveBtn" Grid.Column="2" Style="{StaticResource RemoveButton}" Margin="4,0,0,0"
                        Click="RemoveSuggestion_Click" ToolTip="{Binding RemoveTip}" AutomationProperties.Name="{Binding RemoveTip}">
                    <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{DynamicResource Fg2}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Removable}" Value="True"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="RemoveBtn" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Removable}" Value="True"/>
                        <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="RemoveBtn" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root" Background="{DynamicResource Tint}">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootShift"/>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search box -->
        <Border Grid.Row="0" Margin="24,22,24,10" Height="44" CornerRadius="22" Background="{DynamicResource BoxBg}"
                BorderBrush="{DynamicResource BoxStroke}" BorderThickness="1">
            <Grid Margin="16,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Path Data="{x:Static local:Glyphs.Search}" Stroke="{DynamicResource Fg2}" StrokeThickness="1.6" Stretch="Uniform" Width="16" Height="16"
                      HorizontalAlignment="Left" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <TextBlock x:Name="Placeholder" Grid.Column="1" VerticalAlignment="Center" FontSize="15.5" Margin="2,0,0,0"
                           Foreground="{DynamicResource Fg3}" Text="Search apps, files, settings and the web" IsHitTestVisible="False"/>
                <TextBlock x:Name="Ghost" Grid.Column="1" VerticalAlignment="Center" FontSize="15.5" Margin="2,0,0,0" IsHitTestVisible="False" TextTrimming="None">
                    <Run x:Name="GhostTyped" Foreground="Transparent"/><Run x:Name="GhostRest" Foreground="{DynamicResource Fg3}"/>
                </TextBlock>
                <TextBox x:Name="SearchBox" Grid.Column="1" FontSize="15.5" Background="Transparent" BorderThickness="0" Padding="0"
                         VerticalAlignment="Center" Foreground="{DynamicResource Fg1}" CaretBrush="{DynamicResource Fg1}"
                         SelectionBrush="{DynamicResource Accent}" FocusVisualStyle="{x:Null}" InputMethod.IsInputMethodEnabled="True">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ClearButton" Style="{StaticResource SubtleButton}" Padding="8" Visibility="Collapsed" Click="Clear_Click" ToolTip="Clear (Esc)" Focusable="False">
                        <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{DynamicResource Fg2}" StrokeThickness="1.3"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- HOME VIEW (empty query): pinned, recommended, searches -->
        <ScrollViewer x:Name="HomeView" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="24,0,20,0">
            <StackPanel Margin="0,4,0,8">
                <Grid Margin="8,6,4,6">
                    <TextBlock Text="Pinned" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource FluentButton}" HorizontalAlignment="Right" Padding="10,3" FontSize="12" Click="AddPin_Click" Focusable="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Add" Margin="0,0,6,0"/>
                            <Path Data="{x:Static local:Glyphs.Plus}" Stroke="{DynamicResource Fg1}" StrokeThickness="1.3" Stretch="Uniform" Width="8" Height="8"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <ItemsControl x:Name="PinsList" Focusable="False" Background="Transparent"
                              PreviewMouseLeftButtonDown="Pins_PreviewMouseDown" PreviewMouseMove="Pins_PreviewMouseMove"
                              PreviewMouseLeftButtonUp="Pins_PreviewMouseUp" LostMouseCapture="Pins_LostMouseCapture">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TileButton}" Content="{Binding}" ContentTemplate="{StaticResource TileTemplate}"
                                    Click="HomeItem_Click" MouseRightButtonUp="HomeItem_RightClick" ToolTip="{Binding Subtitle}"
                                    AutomationProperties.Name="{Binding Title}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="NoPins" Margin="8,4,0,8" Foreground="{DynamicResource Fg3}" TextWrapping="Wrap" Visibility="Collapsed"
                           Text="Right-click any app or file in search results and choose Pin, or use Add. Drag pins to rearrange them."/>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Recommended" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,6"/>
                        <ItemsControl x:Name="RecommendedList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowButton}" Content="{Binding}" ContentTemplate="{StaticResource RowTemplate}"
                                            Click="HomeItem_Click" MouseRightButtonUp="HomeItem_RightClick" ToolTip="{Binding Target}"
                                            AutomationProperties.Name="{Binding Title}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Searches" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,6"/>
                        <ItemsControl x:Name="SearchesList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowButton}" Content="{Binding}" ContentTemplate="{StaticResource RowTemplate}"
                                            Click="HomeItem_Click" MouseRightButtonUp="HomeItem_RightClick" AutomationProperties.Name="{Binding Title}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- RESULTS VIEW -->
        <Grid x:Name="ResultsView" Grid.Row="1" Margin="24,0,24,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="320"/>
                <ColumnDefinition x:Name="GapColumn" Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="ResultsList" Background="Transparent" BorderThickness="0" Focusable="False"
                     ItemTemplateSelector="{StaticResource Selector}" ItemContainerStyle="{StaticResource ResultContainer}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="False"
                     SelectionChanged="ResultsList_SelectionChanged" PreviewMouseLeftButtonUp="ResultsList_Click"
                     PreviewMouseRightButtonUp="ResultsList_RightClick"/>

            <!-- Preview / answer pane -->
            <Border Grid.Column="2" CornerRadius="8" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" Margin="0,4,0,8">
                <Grid>
                    <!-- Gemini answer -->
                    <Grid x:Name="AnswerPanel" Margin="18,14,14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{x:Static local:Glyphs.Sparkle}" Fill="{DynamicResource GeminiBrush}" Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="SparkleSpin" CenterX="8" CenterY="8"/>
                                    </Path.RenderTransform>
                                </Path>
                                <TextBlock Text="Gemini" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="AnswerStatus" Margin="10,0,0,0" Foreground="{DynamicResource Fg3}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="AnswerQuery" Grid.Row="0" Visibility="Collapsed"/>
                        <FlowDocumentScrollViewer x:Name="AnswerViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  IsToolBarVisible="False" Focusable="False" SelectionBrush="{DynamicResource Accent}" Margin="-4,0,0,0">
                            <FlowDocument x:Name="AnswerDoc" FontFamily="{StaticResource UiFont}" FontSize="13.5" LineHeight="20" PagePadding="4,0,8,0"
                                          Foreground="{DynamicResource Fg1}" TextAlignment="Left"/>
                        </FlowDocumentScrollViewer>
                        <StackPanel Grid.Row="2" x:Name="SourcesPanel" Margin="0,8,0,0">
                            <TextBlock x:Name="SourcesLabel" Text="Sources" FontSize="11.5" Foreground="{DynamicResource Fg3}" Margin="0,0,0,5"/>
                            <WrapPanel x:Name="SourceChips"/>
                        </StackPanel>
                        <Grid Grid.Row="3" Margin="0,4,0,0">
                            <WrapPanel x:Name="SearchChips" VerticalAlignment="Center" Margin="0,0,180,0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Button x:Name="CopyAnswer" Style="{StaticResource SubtleButton}" Padding="8,5" Click="CopyAnswer_Click" Focusable="False" ToolTip="Copy answer">
                                    <TextBlock Text="Copy" FontSize="12" Foreground="{DynamicResource Fg2}"/>
                                </Button>
                                <Button Style="{StaticResource FluentButton}" Padding="10,5" Margin="6,0,0,0" Click="OpenGoogle_Click" Focusable="False" ToolTip="Ctrl+Enter">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{x:Static local:Glyphs.Globe}" Stroke="{DynamicResource Fg1}" StrokeThickness="1.2" Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="Open in Google" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Google results page (WebView2 is added to GoogleHost in code) -->
                    <Grid x:Name="GooglePanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="16,7,7,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{x:Static local:Glyphs.Globe}" Stroke="{DynamicResource Fg2}" StrokeThickness="1.3" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Google" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="GoogleStatus" Margin="10,0,0,0" Foreground="{DynamicResource Fg3}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="GoogleExpandButton" Style="{StaticResource SubtleButton}" Padding="8,6" Click="GoogleExpand_Click" Focusable="False" ToolTip="Full-size page (Enter or Ctrl+E)">
                                    <Path x:Name="GoogleExpandGlyph" Data="{x:Static local:Glyphs.Expand}" Stroke="{DynamicResource Fg1}" StrokeThickness="1.3" Stretch="Uniform" Width="12" Height="12"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Button>
                                <Button Style="{StaticResource FluentButton}" Padding="10,4" Margin="4,0,0,0" Click="OpenGoogle_Click" Focusable="False" ToolTip="Ctrl+Enter">
                                    <TextBlock Text="Open in browser" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="GoogleHost" Grid.Row="1" Margin="5,0,5,5">
                            <StackPanel x:Name="GoogleMessagePanel" VerticalAlignment="Center" Margin="18,0">
                                <TextBlock x:Name="GoogleMessage" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Fg2}" Text="Loading Google…"/>
                                <Button x:Name="GoogleInstallButton" Style="{StaticResource FluentButton}" HorizontalAlignment="Center" Margin="0,14,0,0" Padding="12,6"
                                        Click="InstallWebView2_Click" Focusable="False" Visibility="Collapsed">
                                    <TextBlock Text="Get WebView2 from Microsoft" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Item details (apps, files, settings...) -->
                    <StackPanel x:Name="DetailPanel" Margin="22,26,22,16" Visibility="Collapsed">
                        <Grid Width="64" Height="64" HorizontalAlignment="Center" Margin="0,8,0,12">
                            <Image x:Name="DetailIcon" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Path x:Name="DetailGlyph" Stroke="{DynamicResource Fg2}" StrokeThickness="1.3" Stretch="Uniform" Width="40" Height="40"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                        <TextBlock x:Name="DetailTitle" FontFamily="{StaticResource UiFontDisplay}" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailKind" FontSize="12" Foreground="{DynamicResource Fg2}" TextAlignment="Center" Margin="0,2,0,0"/>
                        <TextBlock x:Name="DetailPath" FontSize="11.5" Foreground="{DynamicResource Fg3}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="48"/>
                        <Border Height="1" Background="{DynamicResource Divider}" Margin="0,16,0,8"/>
                        <StackPanel x:Name="DetailActions"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="24,0,14,0" Height="44">
            <Grid>
                <TextBlock x:Name="FooterHint" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource Fg3}"
                           Text="Type to search  ·  ↑↓ to move  ·  Enter to open  ·  Esc to close"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="ModelBadge" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource Fg3}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource SubtleButton}" Padding="8" Click="Settings_Click" ToolTip="Settings (Ctrl+,)" Focusable="False">
                        <Path Data="{x:Static local:Glyphs.Gear}" Stroke="{DynamicResource Fg1}" StrokeThickness="1.3" Stretch="Uniform" Width="15" Height="15"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
