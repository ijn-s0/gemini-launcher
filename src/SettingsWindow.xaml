<Window x:Class="GeminiLauncher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gemini Launcher Settings" Width="680" Height="780" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Fg1}"
        FontFamily="{StaticResource UiFont}" FontSize="13.5" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="2,22,0,8"/>
        </Style>
        <Style x:Key="Desc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,6,24,16">
            <StackPanel>
                <TextBlock Text="Settings" FontFamily="{StaticResource UiFontDisplay}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/>

                <!-- Gemini -->
                <TextBlock Text="Gemini" Style="{StaticResource Section}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Gemini API key"/>
                        <TextBlock Style="{StaticResource Desc}">
                            Stored encrypted for your Windows account only.
                            <Hyperlink x:Name="KeyLink" Foreground="{DynamicResource AccentText}" TextDecorations="{x:Null}" Click="KeyLink_Click">Get a free key in Google AI Studio</Hyperlink>
                        </TextBlock>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="KeyBox" Style="{StaticResource FluentPasswordBox}" Height="32"/>
                            <Button Grid.Column="1" Style="{StaticResource FluentButton}" Content="Test" Margin="8,0,0,0" Height="32" Click="Test_Click"/>
                        </Grid>
                        <TextBlock x:Name="TestResult" Style="{StaticResource Desc}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Model"/>
                            <TextBlock Style="{StaticResource Desc}" Text="Flash-Lite is fastest. Flash gives richer answers. You can type any model name."/>
                        </StackPanel>
                        <ComboBox x:Name="ModelBox" Grid.Column="1" Style="{StaticResource FluentCombo}" IsEditable="True" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Thinking level"/>
                            <TextBlock Style="{StaticResource Desc}" Text="More thinking gives better answers to harder questions but takes longer."/>
                        </StackPanel>
                        <ComboBox x:Name="ThinkingBox" Grid.Column="1" Style="{StaticResource FluentCombo}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Grounding tools"/>
                        <TextBlock Style="{StaticResource Desc}" Text="All three can be on together. If a model doesn't accept a combination, the launcher automatically retries without the conflicting tool."/>
                        <CheckBox x:Name="ToolSearchBox" Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Google Search"/>
                                <TextBlock Style="{StaticResource Desc}" Text="Up-to-date facts and news, with sources."/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="ToolMapsBox" Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Google Maps"/>
                                <TextBlock Style="{StaticResource Desc}" Text="Places, businesses, hours, ratings and directions. Results link to Google Maps."/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="LocationBox" Style="{StaticResource ToggleSwitch}" Margin="24,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Use my location for Google Maps"/>
                                <TextBlock Style="{StaticResource Desc}" Text="Sends your approximate location (about 100 m) with Maps questions so &quot;near me&quot; works. Uses Windows location services."/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="ToolUrlBox" Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="URL context"/>
                                <TextBlock Style="{StaticResource Desc}" Text="Reads web pages you paste or mention, so Gemini can summarize them or answer questions about them."/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <CheckBox x:Name="SafetyBox" Style="{StaticResource ToggleSwitch}">
                        <StackPanel>
                            <TextBlock Text="Safety filters"/>
                            <TextBlock Style="{StaticResource Desc}" Text="Off: every adjustable Gemini safety filter (harassment, hate speech, sexually explicit, dangerous content, jailbreak) is set to OFF. Google's built-in protections still apply."/>
                        </StackPanel>
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="InstantBox" Style="{StaticResource ToggleSwitch}">
                            <StackPanel>
                                <TextBlock Text="Instant answers while typing"/>
                                <TextBlock Style="{StaticResource Desc}" Text="When you pause typing with the Gemini row selected, Gemini answers automatically. Turn off to only ask when you press Enter (saves API quota)."/>
                            </StackPanel>
                        </CheckBox>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Pause before answering" VerticalAlignment="Center" Foreground="{DynamicResource Fg2}"/>
                            <ComboBox x:Name="DelayBox" Grid.Column="1" Style="{StaticResource FluentCombo}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Start menu replacement -->
                <TextBlock Text="Replace the Start menu" Style="{StaticResource Section}"/>
                <Border Style="{StaticResource Card}">
                    <CheckBox x:Name="WinKeyBox" Style="{StaticResource ToggleSwitch}">
                        <StackPanel>
                            <TextBlock Text="Windows key opens this launcher"/>
                            <TextBlock Style="{StaticResource Desc}" Text="Tapping the Windows key opens Gemini Launcher instead of Start. Shortcuts like Win+E, Win+D and Win+Shift+S keep working."/>
                        </StackPanel>
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource Card}">
                    <CheckBox x:Name="StartBtnBox" Style="{StaticResource ToggleSwitch}">
                        <StackPanel>
                            <TextBlock Text="Taskbar Start button opens this launcher"/>
                            <TextBlock Style="{StaticResource Desc}" Text="Clicking the Windows logo on the taskbar opens Gemini Launcher instead of Start."/>
                        </StackPanel>
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Need the regular Start menu?"/>
                            <TextBlock Style="{StaticResource Desc}" Text="Press Ctrl+Esc, or hold Shift while clicking the Start button. Turning both switches off gives you the native Start menu back completely."/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource FluentButton}" Content="Open native Start" VerticalAlignment="Center" Margin="12,0,0,0" Click="NativeStart_Click"/>
                    </Grid>
                </Border>

                <!-- Startup -->
                <TextBlock Text="Startup" Style="{StaticResource Section}"/>
                <Border Style="{StaticResource Card}">
                    <CheckBox x:Name="StartupBox" Style="{StaticResource ToggleSwitch}">
                        <StackPanel>
                            <TextBlock Text="Start with Windows"/>
                            <TextBlock Style="{StaticResource Desc}" Text="Runs quietly in the tray after you sign in (uses about 30–60 MB of memory while idle)."/>
                        </StackPanel>
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource Card}">
                    <CheckBox x:Name="ElevatedBox" Style="{StaticResource ToggleSwitch}">
                        <StackPanel>
                            <TextBlock Text="Also work over admin apps"/>
                            <TextBlock Style="{StaticResource Desc}" Text="Windows blocks normal apps from seeing keys pressed in apps running as administrator (Task Manager, admin terminals). This starts the launcher with admin rights at sign-in so the Windows key works everywhere. Apps you open from the launcher still run normally. Needs one admin prompt."/>
                        </StackPanel>
                    </CheckBox>
                </Border>

                <!-- Search -->
                <TextBlock Text="Search &amp; recommendations" Style="{StaticResource Section}"/>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="When you search the web, show"/>
                            <TextBlock Style="{StaticResource Desc}" Text="Google results: the real Google results page, right in the launcher. Press Enter for the full-size page and Ctrl+Enter to open it in your browser. Gemini answer: an AI answer grounded in Google Search. The other one is always one row below."/>
                        </StackPanel>
                        <ComboBox x:Name="WebPreviewBox" Grid.Column="1" Style="{StaticResource FluentCombo}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <CheckBox x:Name="ContentsBox" Style="{StaticResource ToggleSwitch}">
                        <StackPanel>
                            <TextBlock Text="Search inside documents"/>
                            <TextBlock Style="{StaticResource Desc}" Text="Also match words inside your documents, using the Windows Search index. File names are always searched."/>
                        </StackPanel>
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="TrendingBox" Style="{StaticResource ToggleSwitch}">
                            <StackPanel>
                                <TextBlock Text="Show trending searches"/>
                                <TextBlock Style="{StaticResource Desc}" Text="Google Trends suggestions on the home screen, next to your recent searches."/>
                            </StackPanel>
                        </CheckBox>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Trends region (2-letter code, blank = automatic)" VerticalAlignment="Center" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap"/>
                            <TextBox x:Name="RegionBox" Grid.Column="1" Style="{StaticResource FluentTextBox}" Height="32" MaxLength="2" CharacterCasing="Upper"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Appearance -->
                <TextBlock Text="Appearance" Style="{StaticResource Section}"/>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Theme"/>
                            <TextBlock Style="{StaticResource Desc}" Text="Follows Windows light/dark mode, accent color and transparency effects by default."/>
                        </StackPanel>
                        <ComboBox x:Name="ThemeBox" Grid.Column="1" Style="{StaticResource FluentCombo}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Data -->
                <TextBlock Text="Data" Style="{StaticResource Section}"/>
                <Border Style="{StaticResource Card}">
                    <WrapPanel>
                        <Button Style="{StaticResource FluentButton}" Content="Clear search history" Margin="0,0,8,8" Click="ClearHistory_Click"/>
                        <Button x:Name="RestoreHiddenButton" Style="{StaticResource FluentButton}" Content="Restore removed suggestions" Margin="0,0,8,8" Click="RestoreHidden_Click"/>
                        <Button Style="{StaticResource FluentButton}" Content="Rebuild app list" Margin="0,0,8,8" Click="Rebuild_Click"/>
                        <Button Style="{StaticResource FluentButton}" Content="Open data folder" Margin="0,0,8,8" Click="DataFolder_Click"/>
                    </WrapPanel>
                </Border>
                <TextBlock x:Name="VersionText" Style="{StaticResource Desc}" Margin="2,14,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Button Style="{StaticResource SubtleButton}" Content="Exit Gemini Launcher" HorizontalAlignment="Left" Click="Exit_Click" Foreground="{DynamicResource Fg2}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource FluentButton}" Content="Cancel" Width="96" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
                    <Button Style="{StaticResource AccentButton}" Content="Save" Width="96" Click="Save_Click" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
